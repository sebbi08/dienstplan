# Copy to .env next to docker-compose.yml and fill in.
# At least 32 random characters, e.g. from "openssl rand -base64 32" or a password manager.
NUXT_APP_SECRET=
ADMIN_USERNAME=admin
# Only used on the very first start; must be changed at first login.
ADMIN_PASSWORD=
# Emergency only, if the password of the only admin is lost: set a new password here (at least 8
# characters) for the user named in ADMIN_USERNAME, run "docker compose up -d", log in and choose
# a new password, then remove this line again and run "docker compose up -d" once more.
# ADMIN_RESET_PASSWORD=
# Domain for HTTPS via Caddy (docker compose --profile https up -d)
DOMAIN=dienstplan.example.org
# Set to false only if the app is reached without HTTPS (e.g. only inside the local network).
NUXT_SESSION_COOKIE_SECURE=true
# 127.0.0.1 = only reachable through Caddy/HTTPS on this server.
# 0.0.0.0 = im lokalen Netz erreichbar, nur ohne HTTPS (then also set NUXT_SESSION_COOKIE_SECURE=false).
BIND_ADDRESS=127.0.0.1
